{
  "name": "second-brain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@tldraw/tlschema": "5.3.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "iron-session": "^8.0.4",
    "marked": "^18.0.9",
    "next": "16.3.1",
    "node-html-parser": "^9.0.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldraw": "^5.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.147.0"
  }
}
