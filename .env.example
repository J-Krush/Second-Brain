# Neon connection string (pooled). Locally: the docker pgvector instance.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/secondbrain
# argon2id hash of the app password. Generate: pnpm hash-password "your password"
# LOCAL .env files only: escape every '$' as '\$' (Next runs dotenv-expand, which
# treats '$' as a variable reference). On Vercel paste the RAW hash (no escaping).
APP_PASSWORD_HASH=

# 32+ random bytes for cookie sealing. Generate: openssl rand -hex 32
SESSION_SECRET=

# Long random token for non-browser capture clients (menu-bar app, iOS shortcut).
API_TOKEN=

# Cloudflare R2 (S3 API). Bucket must be private.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override the S3 endpoint (MinIO/NAS). Omit for Cloudflare R2.
R2_ENDPOINT=

# Embeddings only. Without it, semantic/hybrid search degrade to full-text.
OPENAI_API_KEY=

# Vercel cron auth: set on Vercel; cron requests send it as a Bearer token.
CRON_SECRET=
