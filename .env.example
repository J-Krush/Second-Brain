# ---- Local dev (`next dev`) reads .env.local. `wrangler dev` reads .dev.vars
# ---- (same keys). Production: non-secrets live in wrangler.jsonc `vars`,
# ---- secrets via `wrangler secret put <NAME>`.

# Docker pgvector for local dev + scripts. In production the Worker connects
# through the HYPERDRIVE binding (wrangler.jsonc), not this variable.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/secondbrain

# PBKDF2 hash of the app password. Generate: pnpm hash-password "your password"
APP_PASSWORD_HASH=

# 32+ random bytes for cookie sealing. Generate: openssl rand -hex 32
SESSION_SECRET=

# Long random token for non-browser capture clients (menu-bar app, iOS shortcut).
API_TOKEN=

# Cloudflare R2 via the S3 API. Bucket must be private.
# Local dev (docker compose MinIO): account id is unused but must be set.
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=secondbrain-dev
# S3 endpoint override. Keep for MinIO; OMIT for real R2 (derived from account id).
R2_ENDPOINT=http://localhost:9000

# Workers AI embeddings (@cf/baai/bge-m3). Token: dashboard -> Workers AI ->
# "Use REST API" -> create token. Without these, search degrades to full-text.
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# Shared secret the Cron Trigger presents as a Bearer token to /api/admin/*.
CRON_SECRET=
